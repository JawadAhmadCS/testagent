OPENAI_API_KEY=your_openai_key
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_SERVICE_ACCOUNT_B64=base64_of_full_service_account_json
# Optional fallback if you don't use GOOGLE_SERVICE_ACCOUNT_B64 / GOOGLE_SERVICE_ACCOUNT_JSON:
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
CHIRP_VOICE_EN=en-US-Chirp3-HD-Kore
# Hebrew TTS voice (Google). You can change to a Chirp/Wavenet voice available in your project.
CHIRP_VOICE_HE=he-IL-Wavenet-C
# Optional: comma-separated Hebrew voices to show in UI dropdown.
CHIRP_VOICES_HE=he-IL-Wavenet-C,he-IL-Wavenet-A,he-IL-Wavenet-B,he-IL-Wavenet-D
PORT=3000
FAST_RESPONSE_MODE=1
FAST_LLM_MODEL=gpt-4o-mini
FAST_MAX_TOKENS=40
# Optional: tighter Hebrew replies for lower latency.
FAST_MAX_TOKENS_HE=80
